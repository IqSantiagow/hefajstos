/* ============================================================
   Design tokens
   Only for colours the pi-dark theme (set in ui/app.py) does not
   provide. $primary / $secondary / $surface / $panel / $success /
   $error / $warning all come from the Theme - do not redefine them.
   Values approximate pi's dark.json.
   ============================================================ */
$muted-color: #a1a4ad;
$dim-color: #828695;
$border-muted: #5c606b;
$user-message-bg: #2a3558;
$tool-pending-bg: #313338;
$tool-success-bg: #1d4232;
$tool-error-bg: #4f2a22;

Screen {
    background: $surface;
    layout: vertical;
}

/* Universal visibility switch, added and removed from Python. */
.hidden {
    display: none;
}

/* Dev tool: add manually to any widget's classes to see its box. */
.border-debug {
    border: solid red;
}

/* ============================================================
   Chat feed
   (WidgetChatFeed, WidgetAgentMessage, WidgetUserMessage, WidgetToolCall)
   Nothing is labelled - the background tells the entries apart.
   ============================================================ */
#chat-feed {
    height: 1fr;
    width: 100%;
    padding: 1 1 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $border-muted;
}

.chat-entry {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.user-entry {
    background: $user-message-bg;
    padding: 1 1;
}

.agent-entry {
    padding: 0 1;
}

.notice-entry { color: $dim-color; padding: 0 1; }
.error-entry  { color: $error; padding: 0 1; }

/* --- tool calls --- */
.tool-entry {
    background: $tool-pending-bg;
    padding: 1 1;
}

/* The background follows the result - set from Python. */
.tool-entry.-success { background: $tool-success-bg; }
.tool-entry.-error   { background: $tool-error-bg; }

.tool-call-row {
    width: 100%;
    height: auto;
}

.tool-name {
    text-style: bold;
    margin-right: 1;
}

.tool-call-summary {
    width: 1fr;
    height: auto;
}

.tool-result {
    width: 100%;
    height: auto;
    color: $muted-color;
    margin-top: 1;
}

/* ============================================================
   Working indicator
   (WidgetWorkingIndicator)
   ============================================================ */
#working-indicator {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $muted-color;
}

/* ============================================================
   Prompt row - between two thin lines
   (WidgetPromptInput)
   ============================================================ */
#prompt-row {
    width: 100%;
    height: auto;
    border-top: solid $border-muted;
    border-bottom: solid $border-muted;
}

#prompt-input {
    width: 100%;
    border: none;
    background: transparent;
    padding: 0 1;
}

/* ============================================================
   Status footer
   (WidgetStatusFooter)
   ============================================================ */
.status-footer {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $dim-color;
}

#footer-directory {
    width: 100%;
    text-overflow: ellipsis;
}

.footer-stats {
    width: 100%;
    height: 1;
}

#footer-tokens {
    width: 1fr;
}

/* ============================================================
   Permission bar
   (ModalPermissionScreen)
   ============================================================ */
ModalPermissionScreen {
    align: center bottom;
    background: $surface 40%;
}

#permission-dialog {
    width: 100%;
    height: auto;
    max-height: 80%;
    padding: 0 1;
    background: $surface;
    border-top: solid $warning;
    border-bottom: solid $warning;
}

.permission-title {
    color: $warning;
    text-style: bold;
    width: 100%;
}

.permission-summary {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.permission-detail {
    width: 100%;
    height: auto;
    max-height: 20;
    overflow-y: auto;
    color: $muted-color;
    margin-top: 1;
}

.permission-hint {
    width: 100%;
    color: $dim-color;
    margin-top: 1;
}
