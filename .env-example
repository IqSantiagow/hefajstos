# Copy to .env and edit. Every value has a default, so .env is optional.
LOGGING__LEVEL=INFO

# 'auto' lets Copilot pick. Run scripts/probe_copilot.py to list the real names -
# they change often and a wrong one fails at startup with the list printed out.
AGENT__MODEL=auto
# Approve every tool without asking. Handy in a scratch repo, risky anywhere else.
AGENT__AUTO_APPROVE=false
AGENT__PERMISSION_TIMEOUT_SECONDS=600
# Empty means "the directory hefajstos was started in".
AGENT__WORKING_DIRECTORY=

# The GitHub token is NOT read from here - the Copilot SDK picks up
# COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN or your keychain login itself.
